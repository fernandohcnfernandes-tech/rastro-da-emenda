# Copie para .env e preencha. Nunca commite o .env.
DATABASE_URL=postgresql+psycopg://rastro:rastro@localhost:5432/rastro
# Porta do Postgres no host (docker compose); ajuste DATABASE_URL junto se mudar
RASTRO_DB_PORTA=5432
# Porta da API (uvicorn) e URL usada pelo frontend
API_PORTA=8000
NEXT_PUBLIC_API_URL=http://localhost:8000

# IA (Anthropic)
ANTHROPIC_API_KEY=
MODELO_RAPIDO=claude-haiku-5-5
MODELO_ANALISE=claude-sonnet-5-5

# Portal da Transparência — chave gratuita: https://portaldatransparencia.gov.br/api-de-dados/cadastrar-email
PORTAL_TRANSPARENCIA_API_KEY=

# Parâmetros de negócio
DATA_INICIO=2024-01-01
PRAZO_SEM_EVIDENCIA_DIAS=180
LIMITE_POPULACAO_PEQUENO=20000
QUERIDO_DIARIO_REQ_POR_MINUTO=60

# E-mail para alertas (opcional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_REMETENTE=
URL_SITE=http://localhost:3000

# Produção (docker-compose.prod.yml)
POSTGRES_PASSWORD=
WEB_PORTA=3000
